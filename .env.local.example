# Spawn location (default: Times Square, NYC). Try London: 51.5113 / -0.0904
NEXT_PUBLIC_SPAWN_LAT=40.758
NEXT_PUBLIC_SPAWN_LON=-73.9855

# Street-level imagery zoom, 15-19. Higher = sharper ground but 4x tiles/GPU
# memory per +1. 17 is ~0.9 m/px.
NEXT_PUBLIC_IMAGERY_ZOOM=17

# Terrain chunk ring radius. 2 -> 5x5 chunks (~4.6 km square).
NEXT_PUBLIC_LOAD_RADIUS=2

NEXT_PUBLIC_FETCH_CONCURRENCY=6

# Optional: a Mapbox token switches imagery to Mapbox Satellite (512px @2x).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional custom XYZ tile templates using {z}/{x}/{y} tokens.
# Terrain templates must serve terrarium-encoded tiles,
# e.g. https://tiles.mapterhorn.com/{z}/{x}/{y}.webp
NEXT_PUBLIC_IMAGERY_TEMPLATE=
NEXT_PUBLIC_TERRAIN_TEMPLATE=
