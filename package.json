{
  "name": "world-walk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run sim:dev",
    "dev": "next dev -p 3001",
    "build": "npm run sim:build && next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "sim:build": "wasm-pack build sim --target web --release && node scripts/copy-wasm.mjs",
    "sim:dev": "wasm-pack build sim --target web --dev && node scripts/copy-wasm.mjs",
    "sim:test": "cargo test --manifest-path sim/Cargo.toml"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.3",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "next": "16.2.9",
    "pbf": "^4.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.184.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.1",
    "typescript": "6.0.3"
  }
}
